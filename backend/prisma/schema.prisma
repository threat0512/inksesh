generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  IMAGE
  VIDEO
}

model AdminUser {
  id        String   @id @default(uuid())
  phone     String   @unique
  createdAt DateTime @default(now())
}

model Studio {
  id          String   @id @default(uuid())
  name        String
  area        String?
  specialties String[]
  createdAt   DateTime @default(now())

  artists     Artist[]
  assets      Asset[]
}

model Artist {
  id        String   @id @default(uuid())
  studioId  String
  name      String
  styles    String[]
  createdAt DateTime @default(now())

  studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
}

model Asset {
  id                String    @id @default(uuid())
  studioId          String
  type              AssetType
  mimeType          String
  originalKey       String
  originalSizeBytes Int?
  status            String    @default("UPLOADED")
  createdAt         DateTime  @default(now())

  studio            Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  variants          AssetVariant[]

  @@index([studioId])
}

model AssetVariant {
  id        String   @id @default(uuid())
  assetId   String
  kind      String
  key       String
  format    String
  width     Int?
  height    Int?
  sizeBytes Int?
  createdAt DateTime @default(now())

  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@unique([assetId, kind])
}
