{
  "name": "inksesh-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:worker\"",
    "build": "tsc",
    "start": "concurrently \"node dist/index.js\" \"node dist/worker.js\"",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.972.0",
    "@aws-sdk/s3-request-presigner": "^3.972.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.17.2",
    "pg-boss": "^12.5.4",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ffmpeg-static": "^5.1.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.30",
    "@types/pg": "^8.16.0",
    "concurrently": "^9.1.2",
    "prisma": "^5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4"
  }
}
